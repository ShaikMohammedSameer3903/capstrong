# ─── Core Secrets (REQUIRED) ───
JWT_SECRET=your-super-secure-jwt-secret-key
SESSION_SECRET=your-session-secret-key
REFRESH_SECRET=your-refresh-secret-key

# ─── Frontend URL (REQUIRED for CORS, OAuth callbacks) ───
FRONTEND_URL=http://localhost:5173

# ─── Microsoft Entra ID (Primary Identity Provider) ───
AZURE_CLIENT_ID=your-azure-app-registration-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-default-azure-subscription-id

# ─── Google OAuth (Secondary Identity Provider) ───
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ─── Frontend Variables (Vite — prefixed with VITE_) ───
VITE_API_BASE_URL=
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_APP_URL=http://localhost:5173

# ─── Optional: AWS SSO Configuration ───
VITE_AWS_SSO_START_URL=
VITE_AWS_SSO_REGION=us-east-1

# ─── Optional: Database (PostgreSQL for production) ───
# DATABASE_URL=postgresql://user:password@host:5432/cloudops

# ─── Optional: Additional CORS Origins (comma-separated) ───
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://custom-domain.com
