# Multi-Stage Production Dockerfile for CloudOps Backend Server
FROM node:20-alpine AS build

WORKDIR /app

# Install native compilation dependencies for sqlite3 and git
RUN apk add --no-cache python3 make g++ git gcompat icu-libs

# Copy package descriptors and install dependencies
COPY server/package*.json ./server/

WORKDIR /app/server
RUN npm install --omit=dev --legacy-peer-deps

# Copy server codebase
COPY server/ ./

FROM node:20-alpine AS runner

WORKDIR /app/server
ENV NODE_ENV=production
ENV PORT=3001
ENV DATABASE_PATH=/app/server/data/cloudops.db

# Install git, curl, wget, gcompat (glibc compatibility for SWA CLI), and icu-libs (.NET globalization)
RUN apk add --no-cache git curl wget gcompat icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Create persistent data directory and ensure proper permissions
RUN mkdir -p /app/server/data/apps /app/server/data/cached_repos /app/server/data/workspaces /tmp/cloudops_workspaces && \
    chown -R node:node /app /tmp/cloudops_workspaces && \
    chmod -R 777 /app/server/data /tmp/cloudops_workspaces

# Copy server codebase and node_modules from build stage
COPY --from=build --chown=node:node /app/server ./

# Expose Backend API Port
EXPOSE 3001

USER node

CMD ["node", "--max-old-space-size=400", "index.js"]

