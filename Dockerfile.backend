# Multi-Stage Production Dockerfile for CLOUD-223 Backend Server
FROM node:20-alpine AS build

WORKDIR /app

# Copy package descriptors and install dependencies
COPY server/package*.json ./server/
WORKDIR /app/server
RUN npm ci --only=production

# Copy server codebase
COPY server/ ./

FROM node:20-alpine AS runner

WORKDIR /app/server
ENV NODE_ENV=production
ENV PORT=5000

# Copy node_modules and server codebase from build stage with correct ownership
COPY --from=build --chown=node:node /app/server ./

# Expose dedicated Backend API Port 5000
EXPOSE 5000

USER node

CMD ["node", "--max-old-space-size=400", "index.js"]
