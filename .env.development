# ============================================================
# CloudOps Multi-Cloud Application Platform - DEVELOPMENT ENV
# Auto-generated on 2026-07-27T13:40:44.682Z
# ============================================================

# HTTP server listening port for backend application
# How to create: Set port number in environment or .env file
# Doc: https://nodejs.org/api/process.html#processenv
PORT=3001

# PostgreSQL or SQLite connection URI string
# How to create: Provision PostgreSQL instance or set DATABASE_PATH for SQLite fallback
# Doc: https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING
DATABASE_URL=

# Cryptographic key used to sign and verify JWT authentication tokens
# How to create: Generate using openssl rand -base64 32
# Doc: https://jwt.io/introduction
JWT_SECRET=cloudops-enterprise-jwt-super-secret-key-2026

# JSON Web Token validity duration
# How to create: Specify duration format (e.g., 1h, 24h, 7d)
# Doc: https://github.com/auth0/node-jsonwebtoken
JWT_EXPIRE=24h

# Azure Active Directory Service Principal Client Application ID
# How to create: Create via Azure CLI: az ad sp create-for-rbac --name CloudOpsApp
# Doc: https://learn.microsoft.com/en-us/azure/developer/javascript/sdk/authentication-overview
AZURE_CLIENT_ID=

# Azure Active Directory Service Principal Secret Key
# How to create: Generate client secret in Microsoft Entra App Registrations portal
# Doc: https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app
AZURE_CLIENT_SECRET=

# Microsoft Entra Organization Tenant Directory ID
# How to create: Find Tenant ID in Microsoft Azure Portal -> Entra ID -> Overview
# Doc: https://learn.microsoft.com/en-us/azure/active-directory/fundamentals/active-directory-how-to-find-tenant
AZURE_TENANT_ID=

# Azure Cloud Subscription Identifier for Resource Management
# How to create: Run az account list in Azure CLI or check Azure Portal subscriptions
# Doc: https://learn.microsoft.com/en-us/azure/azure-portal/get-subscription-tenant-id
AZURE_SUBSCRIPTION_ID=

# Amazon Web Services IAM User Access Key ID
# How to create: Generate in AWS IAM Console -> Users -> Security Credentials
# Doc: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html
AWS_ACCESS_KEY_ID=

# Amazon Web Services IAM User Secret Access Key
# How to create: Saved during IAM Access Key generation in AWS
# Doc: https://docs.aws.amazon.com/general/latest/gr/aws-sec-cred-types.html
AWS_SECRET_ACCESS_KEY=

# Primary Amazon Web Services Deployment Region
# How to create: Specify target region code (e.g., us-east-1, eu-west-1, ap-south-1)
# Doc: https://docs.aws.amazon.com/general/latest/gr/rande.html
AWS_REGION=us-east-1

# Google Cloud Platform Project Identifier
# How to create: Create Project in Google Cloud Console or via gcloud projects create
# Doc: https://cloud.google.com/resource-manager/docs/creating-managing-projects
GCP_PROJECT_ID=

# Base64 string or JSON path for GCP Service Account Credentials
# How to create: Generate Key in GCP IAM & Admin -> Service Accounts -> Keys
# Doc: https://cloud.google.com/iam/docs/keys-create-delete
GCP_SERVICE_ACCOUNT_JSON=

# Container Image Registry URL (ACR, ECR, GAR, Docker Hub, GHCR)
# How to create: Provision Azure Container Registry, AWS ECR, or GitHub Container Registry
# Doc: https://docs.docker.com/docker-hub/repos/official-repositories/
DOCKER_REGISTRY=docker.io

# Redis Cache connection URI string
# How to create: Provision Redis server or Azure Cache for Redis
# Doc: https://redis.io/docs/connect/clients/
REDIS_URL=

# Prometheus Telemetry Server Endpoint URL
# How to create: Deploy Prometheus server or Managed Prometheus instance
# Doc: https://prometheus.io/docs/prometheus/latest/getting_started/
PROMETHEUS_URL=

# Grafana Visualization Dashboard Base URL
# How to create: Deploy Grafana container or Managed Grafana workspace
# Doc: https://grafana.com/docs/grafana/latest/setup-grafana/
GRAFANA_URL=

# OpenTelemetry OTLP Collector Endpoint URL
# How to create: Run OpenTelemetry Collector daemon for trace/metric ingestion
# Doc: https://opentelemetry.io/docs/collector/
OTEL_EXPORTER_OTLP_ENDPOINT=

