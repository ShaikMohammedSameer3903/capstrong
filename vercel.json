{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth-redirect.html",
      "destination": "/auth-redirect.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth-redirect.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
